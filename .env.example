# Referência: exporte estas variáveis no ambiente do processo.
SDR_DATA_DIR=data
LUME_REGISTRATION_OPEN=true
LUME_MAX_USERS=100
LUME_MAX_DAILY_SEARCHES=50
LUME_MAX_CONCURRENT_JOBS=2
LUME_SEARCH_BACKEND=direct
DIRECT_SEARCH_ENGINES=yahoo
COOKIE_SECURE=false
LUME_ENFORCE_HTTPS=false
# Apenas para implantação com HTTPS e proxy corretamente isolado:
# LUME_PUBLIC_URL=https://lume.example.com
# LUME_ALLOWED_HOSTS=lume.example.com
# LUME_TRUSTED_PROXY_IPS=ENDERECO_DO_PROXY
# Integrações opcionais; preencha somente no ambiente privado:
STORELEADS_API_KEY=
# SEARXNG_URL=http://127.0.0.1:8888
